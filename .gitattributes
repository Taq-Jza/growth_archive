# 仓库内统一用 LF。
# Windows 默认会把检出文件转成 CRLF，这样服务器拉下来后 scripts/*.sh 会带上 \r，
# bash 报 `/usr/bin/env: 'bash\r': No such file or directory`，部署脚本直接跑不起来。
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.service text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.json    text eol=lf

# 二进制不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.db   binary
