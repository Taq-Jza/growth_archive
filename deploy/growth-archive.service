[Unit]
Description=Growth Archive (成长档案)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/growth-archive
EnvironmentFile=/opt/growth-archive/.env
ExecStart=/opt/growth-archive/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3
StandardOutput=append:/opt/growth-archive/logs/app.log
StandardError=append:/opt/growth-archive/logs/app.log

[Install]
WantedBy=multi-user.target
