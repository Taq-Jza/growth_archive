# 复制成 .env 后填写。没有 key 也能启动，只是问答降级为检索结果。
# 硅基流动控制台：https://cloud.siliconflow.cn/account/ak
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509
IMAGE_SIZE=1024x768
IMAGE_REDRAW=typeset
LLM_TIMEOUT=30

# 向量检索为可选增强（见设计方案 D-12），主路径不用，留作备用
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

SECRET_KEY=change-me-to-a-random-string
DEMO_EMAIL=demo@local
DEMO_PASSWORD=demo1234

# ---- 联网检索（面试预演的可选增强）----
# 不填就只用模型自带知识；填了就把近期公开真题当作「出题方向」注入提示词。
# 支持 bocha / serper / tavily 三家，填哪家就把 SEARCH_PROVIDER 写成哪家的名字。
# SEARCH_PROVIDER=bocha
# SEARCH_API_KEY=
